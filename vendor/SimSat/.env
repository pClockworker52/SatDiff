# Spike 2 — dummy Mapbox token. The MapboxProvider raises at __init__ if
# this env var is unset (api.py initialises both providers eagerly). We
# only exercise the Sentinel path, so any non-empty string unblocks the
# sim container. Replace with a real token only if Mapbox demo visuals
# are needed for the demo-video step.
MAPBOX_ACCESS_TOKEN=spike2-dummy-not-used
