# llama-server runtime config for SatDiff (Stage 1 GGUF Q8_0).
# This is documentation; the actual values live in inference/llama-server.sh
# (env-var overridable). Keep this file in sync if any value changes.

[server]
binary           = inference/llama.cpp/build-cuda/bin/llama-server   # CUDA build preferred; wrapper falls back to build/ if absent
model            = inference/gguf/LFM2.5-VL-450M-stage1-Q8_0.gguf       # 362 MB, Q8_0
mmproj           = inference/gguf/mmproj-LFM2.5-VL-450M-stage1-Q8_0.gguf  # 182 MB, F16 (always)
host             = 0.0.0.0
port             = 8080
ctx_size         = 8192      # ample for Stage A free-text + Stage B JSON contract prompt
threads          = 4          # CPU threads (CUDA path is GPU-bound, fewer is fine)
n_gpu_layers     = 99         # offload all layers (set to 0 in pure-CPU mode); ~587 MiB VRAM total
ld_library_path  = /home/peter/miniconda3/lib    # required so libcudart/libcublas are findable on the dev box

[client]
endpoint     = POST /v1/chat/completions       # OpenAI-compatible
health       = GET  /health                    # readiness probe
content      = list of {type:image_url|text}   # base64 data URI for images
greedy       = temperature=0.0, stream=false
